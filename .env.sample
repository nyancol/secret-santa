# Sample environment — copy to .env.dev and fill in your values.
# .env.dev is gitignored; this file documents every variable the app reads.
NODE_ENV=development
PORT=3222
HOST=0.0.0.0
DATABASE_PATH=./data/app.db
# Required in production (32+ chars). Dev fallback exists only outside production.
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
COOKIE_SECURE=false
# Dev-only stub login: POST /api/auth/dev-login {"user":"alice"} (forced off in production).
DEV_LOGIN=true
TRUST_PROXY=true
# Public origin of the app (scheme + host + port, no trailing slash).
# The OIDC callback is derived from it: ${APP_ORIGIN}/api/auth/callback.
APP_ORIGIN=http://localhost:3222
# Uncomment for real login (PocketID):
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Explicit override (must exactly match the value registered at the provider).
# Defaults to ${APP_ORIGIN}/api/auth/callback when empty.
# OIDC_REDIRECT_URI=
# Rate limiting (per-IP, per-minute). Tests use a high internal limit.
# RATE_LIMIT_GLOBAL_MAX=600
# Telemetry (OTEL → homelab LGTM). Prod only — set these in the Arcane-managed
# prod .env, never commit values. Unset/empty = telemetry disabled (dev/preprod).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# OTEL_SERVICE_NAME=secret-santa
# DEPLOYMENT_ENVIRONMENT=production
# OTEL_SERVICE_VERSION= (defaults to the package.json version; explicit value wins)
